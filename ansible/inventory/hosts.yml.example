# Generated by Scripts/make-hosts.sh from the bootstrap outputs (hosts.yml is
# ignored by Git). Example with documentation values:
all:
  vars:
    aws_region: eu-west-3
    oidc_issuer_url: https://code-keeper-oidc-example.s3.eu-west-3.amazonaws.com
    oidc_bucket: code-keeper-oidc-example
    tf_state_bucket: code-keeper-tfstate-example
    ecr_registry: 111122223333.dkr.ecr.eu-west-3.amazonaws.com
    ci_role_arns:
      infra: arn:aws:iam::111122223333:role/code-keeper-ci-infra
      inventory-app: arn:aws:iam::111122223333:role/code-keeper-ci-inventory-app
      billing-app: arn:aws:iam::111122223333:role/code-keeper-ci-billing-app
      api-gateway-app: arn:aws:iam::111122223333:role/code-keeper-ci-api-gateway-app
  children:
    controller:
      hosts:
        localhost:
          ansible_connection: local
          ansible_python_interpreter: "{{ ansible_playbook_python }}"
    gitlab:
      hosts:
        gitlab-server:
          ansible_host: 203.0.113.10
    runners:
      hosts:
        gitlab-runner:
          ansible_host: 203.0.113.20
